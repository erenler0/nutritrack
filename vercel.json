{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand":   "npm run dev",
  "installCommand": "npm install",
  "regions": ["fra1"],
  
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=60" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/foods/:path*",
      "destination": "/api/foods/:path*"
    }
  ]
}
