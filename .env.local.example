# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard > Project Settings > API kısmından alın

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Servis rolü — sadece sunucu tarafında (migration, admin işlemler)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  ← Asla frontend'e verme!

# ─── Open Food Facts API (Adım 5'te eklenecek) ───────────────────────────────
# Ücretsiz, API key gerektirmez — URL yeterli
NEXT_PUBLIC_OFF_API_BASE=https://world.openfoodfacts.org/api/v3

# ─── Edamam API (opsiyonel, daha zengin makro verisi) ────────────────────────
# https://developer.edamam.com adresinden ücretsiz hesap açın
# EDAMAM_APP_ID=
# EDAMAM_APP_KEY=

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
